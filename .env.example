# DealGuard AI - Environment Configuration

# Environment Mode: development | staging | production
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dealguard
POSTGRES_PASSWORD=dealguard_secret
POSTGRES_DB=dealguard_ai
DATABASE_URL=postgresql+asyncpg://dealguard:dealguard_secret@localhost:5432/dealguard_ai
DATABASE_URL_SYNC=postgresql://dealguard:dealguard_secret@localhost:5432/dealguard_ai

# Background Workers & Caching (Redis 7 + Celery)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Object Storage (MinIO / S3)
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_DOCUMENTS=dealguard-documents
STORAGE_REGION=us-east-1

# AI & Embedding Services (Gemini Embedding 2 / Vertex / Fallback)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSION=1536
GEMINI_API_KEY=your-gemini-api-key-here

# CORS & Frontend URL
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
